---
// Layout base: <head> completo (spec F.1), JSON-LD (F.3), font, script html.js (D.5).
// La landing (/ e /v/<slug>/) usa i valori di default. 404 e privacy passano title, description, path, noindex, schema.
import '../styles/tokens.css';
import '../styles/global.css';
import archivoUrl from '../assets/fonts/archivo-latin-inst.woff2?url';
import Analytics from '../components/Analytics.astro';
import { SITE_URL, SITE_NAME, SEO } from '../data/site.mjs';
import { grafoJsonLd, jsonLdString } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Percorso canonico con slash finale. Le varianti passano '/' (canonical sempre sulla root). */
  path?: string;
  noindex?: boolean;
  /** true = inserisce il @graph JSON-LD della landing. */
  schema?: boolean;
  /** Slug della variante hero, esposto come <html data-variant> per gli script. */
  variante?: string;
  /** Classi sul <body>. */
  bodyClass?: string;
}

const {
  title = SEO.title,
  description = SEO.description,
  path = '/',
  noindex = false,
  schema = true,
  variante,
  bodyClass,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
// Anteprime Netlify: mai indicizzate (letto in build).
const contesto = process.env.CONTEXT ?? '';
const anteprima = contesto === 'deploy-preview' || contesto === 'branch-deploy';
const robots =
  noindex || anteprima
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const ogImage = new URL(SEO.ogImage, SITE_URL).href;
const ldJson = schema ? jsonLdString(grafoJsonLd()) : null;
---

<!doctype html>
<html lang="it" data-variant={variante}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SEO.author} />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={SEO.ogTitle} />
    <meta property="og:description" content={SEO.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SEO.ogImageWidth)} />
    <meta property="og:image:height" content={String(SEO.ogImageHeight)} />
    <meta property="og:image:alt" content={SEO.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <Analytics />
  </body>
</html>
