---
// Dodici mesi #percorso (spec C.9, B.7.6). Proprietario: engineer "metodo".
// Un'unica griglia, due disposizioni:
// - mobile: binario verticale a sinistra (una riga per mese, numeri dei mesi), testi delle fasi accanto al
//   loro mese d'inizio, nota del mese 3 appuntata alla riga 3; i mesi senza testo restano spazio vuoto;
// - da 1024px: barra orizzontale di 12 mesi, fasi in proporzione (1/12, 7/12, 4/12), nota sopra il mese 3.
// Riempimento delle fasi con animation-timeline: view() solo come miglioramento progressivo:
// senza supporto, o con movimento ridotto, la barra è già piena. Nessuna CTA.
import Section from './Section.astro';
import Icon, { type IconName } from './Icon.astro';
import { percorso } from '../data/pagina';

const { fasi, notaMese3: nota, settimana } = percorso;
const MESI = 12;
// Desktop: la barra si riempie mentre passa dal 75% al 50% dell'altezza dello schermo, mese dopo mese.
const riempi = (mesi: number) => +(25 + (25 * mesi) / MESI).toFixed(2);
// "Dal mese 2 all'8. Costruire" -> ["Dal mese 2 all'8.", "Costruire"]
const mesiFase = (h: string) => {
  const k = h.lastIndexOf('. ');
  return k > 0 ? [h.slice(0, k + 1), h.slice(k + 2)] : [h];
};
---

<Section id={percorso.id} mode="paper" zone="mofu" labelledby={`${percorso.id}-h2`}>
  <div class="wrap">
    <header class="percorso__head flow" style="--flow:var(--space-4)">
      <p class="eyebrow">{percorso.eyebrow}</p>
      <h2 id={`${percorso.id}-h2`}>{percorso.h2}</h2>
      <p class="t-lead t-muted">{percorso.lead}</p>
      {percorso.sintesi && <p class="t-body percorso__sintesi">{percorso.sintesi}</p>}
    </header>

    <div class="percorso__tl">
      {
        Array.from({ length: MESI }, (_, i) => (
          <span class="percorso__m" style={`--i:${i + 1}`} aria-hidden="true">
            {i + 1}
          </span>
        ))
      }
      <span class="percorso__track" aria-hidden="true" />
      {
        fasi.map((f) => (
          <span
            class="percorso__seg"
            style={`--a:${f.daMese};--b:${f.aMese + 1};--c:var(--${f.tono});--r:cover ${riempi(f.daMese - 1)}vh cover ${riempi(f.aMese)}vh`}
            aria-hidden="true"
          />
        ))
      }
      {
        fasi.map((f, i) => (
          <div class="percorso__fase" style={`--a:${f.daMese};--k:${i * 4 + 1};--c:var(--${f.tono})`}>
            {/* "Mese 1. Testare": su mobile i mesi diventano l'etichetta della carta, il nome della fase il titolo. */}
            <h3>{mesiFase(f.h3).map((x, k) => (k === 0 && mesiFase(f.h3).length > 1 ? <span class="percorso__mesi">{x.replace(/\.$/, '')}<span class="percorso__punto">.</span> </span> : x))}</h3>
            <p>{f.testo}</p>
          </div>
        ))
      }
      <p class="percorso__nota t-voice" style={`--a:${nota.mese}`}>{nota.testo}</p>
    </div>

    <p class="percorso__claim">{percorso.claim}</p>

    {
      settimana.length > 0 && (
        <ul class="percorso__sett" role="list">
          {settimana.map((s) => (
            <li>
              <Icon name={s.icona as IconName} class="percorso__ico" />
              {s.testo}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>

<style>
  .percorso__head { max-width: 46rem; }

  .percorso__sintesi { max-width: 46rem; }

  /* ---- Mobile: tre carte di fase impilate (bordo alto nel colore della fase), poi la nota del mese 3. ---- */
  .percorso__tl { display: grid; gap: var(--space-3); margin-top: var(--space-7); }
  .percorso__m, .percorso__track, .percorso__seg { display: none; }
  .percorso__fase {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border-top: 4px solid var(--c);
    border-radius: var(--r-1);
    background: var(--surface);
  }
  .percorso__mesi {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    font-weight: 620;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .percorso__punto { display: none; }
  .percorso__nota { padding: var(--space-3) 0 0 var(--space-4); border-left: 2px solid var(--text); font-size: var(--fs-body); }
  .percorso__claim {
    max-width: 30ch;
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px solid var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-stretch: 82%;
    font-weight: 760;
    line-height: var(--lh-h3);
    text-wrap: balance;
  }
  .percorso__sett { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin-top: var(--space-5); }
  .percorso__sett li { display: flex; align-items: center; gap: var(--space-3); }
  .percorso__ico { flex: none; color: var(--accent-text); }

  /* ---- Da 1024px: barra orizzontale ---- */
  @media (min-width: 1024px) {
    .percorso__tl {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto auto 14px auto;
      gap: 0;
      margin-top: var(--space-8);
    }
    .percorso__m {
      display: block;
      grid-area: 2 / var(--i);
      padding: 0 0 var(--space-3) var(--space-2);
      border-left: 1px solid var(--line-strong);
      font-size: var(--fs-micro);
      font-weight: 620;
      line-height: 1;
      font-variant-numeric: tabular-nums lining-nums;
      color: var(--muted);
    }
    .percorso__track, .percorso__seg { display: block; grid-area: 3 / 1 / 4 / -1; background: var(--line); border-radius: 3px; }
    .percorso__seg { grid-area: 3 / var(--a) / 4 / var(--b); background: var(--c); border-radius: 0; transform-origin: left; }
    .percorso__fase { grid-area: 4 / var(--k) / 5 / span 4; padding: var(--space-6) var(--space-7) 0 0; border: 0; border-radius: 0; background: none; }
    .percorso__fase h3 { font-size: var(--fs-lead); }
    .percorso__fase h3::before {
      content: "";
      display: inline-block;
      width: .7em;
      height: .7em;
      margin-right: .45em;
      background: var(--c);
      border: 1px solid var(--line-strong);
      border-radius: 2px;
    }
    .percorso__punto { display: inline; }
    .percorso__mesi { display: inline; margin: 0; font: inherit; letter-spacing: normal; text-transform: none; color: inherit; }
    .percorso__nota { position: relative; grid-area: 1 / var(--a) / 2 / span 5; padding: 0 0 var(--space-5) var(--space-4); font-size: var(--fs-lead); }
    .percorso__nota::before {
      content: "";
      position: absolute;
      bottom: -7px;
      left: -8px;
      width: 14px;
      height: 14px;
      border: 2px solid var(--text);
      border-radius: 50%;
      background: var(--bg);
    }
    .percorso__claim { margin-top: var(--space-8); }
  }

  /* Riempimento al passaggio (B.7.6): solo dove il browser lo supporta e il movimento è consentito. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .percorso__seg {
        animation-name: percorso-fill;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view();
        animation-range: cover 40vh cover calc(100% - 55vh);
      }
      @media (min-width: 1024px) {
        .percorso__seg { animation-range: var(--r); }
      }
    }
  }
  @keyframes percorso-fill {
    from { transform: scale(var(--sx, 1), var(--sy, 0)); }
    to { transform: none; }
  }
  @media (min-width: 1024px) {
    .percorso__seg { --sx: 0; --sy: 1; }
  }
</style>
