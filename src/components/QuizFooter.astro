// tutti nella pagina /privacy/.
import { LANDING } from '../data/quiz/copy.mjs';
---

<footer class="qfoot">
  <div class="qwrap">
    <div class="qfoot__links">
      <a href="/privacy/">Privacy Policy</a>
    </div>
    <p>{LANDING.footer.disclaimer}</p>
  </div>
</footer>
