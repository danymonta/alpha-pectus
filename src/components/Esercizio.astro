---
// Carta esercizio (spec C.6 #esercizi, E.1, E.2, B.7). Proprietario: tofu-mofu. Usata solo da Postura.astro.
// Stati (E.1), decisi in build:
//   video   public/video/esercizio-N.mp4 esiste: <video> 4:5 muto, in loop, preload none, poster dallo slot foto.
//           Senza JS: controlli nativi. Con JS (scripts/postura.js): la sorgente si carica vicino al viewport,
//           parte al 50% di visibilità, bottone play/pausa 44px; movimento ridotto o risparmio dati: poster + play.
//   poster  video assente, poster presente: solo la foto, nessun bottone play.
//   testo   né video né poster: solo le indicazioni, numero ingrandito.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import { hasFoto, getFoto } from '../lib/foto';

interface Props {
  esercizio: {
    n: number;
    nome: string;
    nomeTecnico: string | null;
    cues: string[];
    chips: string[];
    poster: string;
    video: string;
    videoAria: string;
  };
  etichette: { play: string; pausa: string };
}
const { esercizio: e, etichette } = Astro.props;

const haVideo = existsSync(join(process.cwd(), 'public', e.video));
const haPoster = hasFoto(e.poster);
const stato = haVideo ? 'video' : haPoster ? 'poster' : 'testo';
// Poster del video: un solo WebP 720 x 900, stesso formato del clip (4:5).
const poster =
  haVideo && haPoster
    ? (await getImage({ src: getFoto(e.poster)!, width: 720, height: 900, fit: 'cover', format: 'webp', quality: 72 })).src
    : undefined;
const idH = `esercizio-${e.n}-h4`;
---

<article class:list={['esercizio esercizio__p', { 'esercizio--testo': stato === 'testo' }]} style="--g:var(--space-4)" aria-labelledby={idH}>
  <p class:list={['t-year esercizio__n', { 'esercizio__n--s': stato !== 'testo' }]} aria-hidden="true">{e.n}</p>
  <h4 id={idH}>{e.nome}{e.nomeTecnico && <span class="t-muted"> ({e.nomeTecnico})</span>}</h4>

  {
    stato === 'video' && (
      <div class="esercizio__media" data-esercizio>
        <video
          class="esercizio__video"
          width="720"
          height="900"
          controls
          muted
          loop
          playsinline
          disablepictureinpicture
          preload={poster ? 'none' : 'metadata'}
          poster={poster}
          aria-label={e.videoAria}
        >
          <source src={e.video} type="video/mp4" />
        </video>
        <button
          type="button"
          class="esercizio__btn"
          hidden
          data-esercizio-btn
          data-play={etichette.play}
          data-pausa={etichette.pausa}
          aria-label={etichette.play}
        >
          <Icon name="play" size={20} data-i="play" />
          <Icon name="pause" size={20} data-i="pausa" />
        </button>
      </div>
    )
  }
  {
    stato === 'poster' && (
      <Foto
        slot={e.poster}
        ratio="4:5"
        sizes="(min-width: 1024px) 380px, (min-width: 768px) 60vw, 100vw"
        widths={[360, 480, 720, 960]}
        class="esercizio__media"
      />
    )
  }

  {/* Indicazioni in ordine: <ol>, senza numeri a vista (il numero grande è già quello dell'esercizio). */}
  <ol class="esercizio__cues esercizio__p" style="--g:var(--space-2)" role="list">
    {e.cues.map((c) => <li>{c}</li>)}
  </ol>
</article>

<style>
  .esercizio__p { display: grid; align-content: start; gap: var(--g); }
  .esercizio { padding-top: var(--space-5); border-top: 1px solid var(--line-strong); }
  .esercizio__n { color: var(--accent-text); }
  .esercizio__n { font-size: clamp(3.5rem, 2.8rem + 3vw, 4.5rem); }
  .esercizio__n--s { font-size: 3rem; }
  .esercizio__media { position: relative; overflow: hidden; border-radius: var(--r-2); background: var(--night-surface); }
  .esercizio__video { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .esercizio__btn {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    background: var(--scrim-chip);
    color: var(--night-text);
  }
  /* Lista ordinata senza numerali: un trattino corto in amber-ink. */
  .esercizio__cues { padding: 0; list-style: none; }
  .esercizio__cues li { position: relative; padding-left: var(--space-5); }
  .esercizio__cues li::before { content: ""; position: absolute; left: 0; top: .78em; width: 12px; height: 2px; background: var(--accent-text); }
  /* Senza video né poster: una carta, con il numero grande, così i tre esercizi si leggono come una serie. */
  .esercizio--testo { height: 100%; padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--r-2); background: var(--surface); box-shadow: var(--shadow-card); }
</style>
