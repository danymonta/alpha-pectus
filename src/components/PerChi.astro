---
// Per chi è, per chi non è #per-chi (spec C.14, G.6, G.7). Proprietario: engineer "bofu".
// Golden. Due colonne da 1024px (impilate su mobile): "È per te se" con le spunte --success,
// "Non è per te se" con i punti --steel. Poi il pannello del chirurgo toracico (bordo --steel, icona heart-lungs,
// stesso peso di una carta del metodo), la riga di autorità a --fs-lead e la CTA 3 (ref=pe_perte).
// Nessun link DM dentro "Non è per te se" (G.1). Le righe sull'età escono solo con conferme.politicaMinori18 (già nei dati).
import Section from './Section.astro';
import Icon from './Icon.astro';
import CtaDm from './CtaDm.astro';
import { perChi as p } from '../data/pagina';
---

<Section id={p.id} mode="golden" zone="bofu" labelledby={`${p.id}-h2`}>
  <div class="wrap perchi">
    <header class="perchi__head flow" style="--flow:var(--space-4)">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 id={`${p.id}-h2`}>{p.h2}</h2>
    </header>

    <div class="perchi__col">
      <h3>{p.perTe.h3}</h3>
      <ul role="list">
        {p.perTe.voci.map((v) => (
          <li>
            <Icon name="check" class="perchi__si" />
            <span>{v}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="perchi__col perchi__col--no">
      <h3>{p.nonPerTe.h3}</h3>
      <ul role="list">
        {p.nonPerTe.voci.map((v) => (
          <li>
            <span class="perchi__punto" aria-hidden="true"></span>
            <span>{v}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="perchi__chir" aria-labelledby={`${p.id}-chirurgo`}>
      <Icon name="heart-lungs" size={32} class="perchi__ico" />
      <div class="flow" style="--flow:var(--space-3)">
        <h3 id={`${p.id}-chirurgo`}>{p.chirurgo.h3}</h3>
        <p>{p.chirurgo.testo}</p>
      </div>
    </aside>

    <p class="perchi__aut t-lead">{p.autorita}</p>
    <CtaDm placement={p.cta.placement} leadIn={p.cta.leadIn} class="perchi__cta" />
  </div>
</Section>

<style>
  .perchi { display: grid; gap: var(--space-7); }
  .perchi__head { max-width: 46rem; }
  .perchi__col ul { margin-top: var(--space-4); border-top: 1px solid var(--line); }
  .perchi__col li { display: flex; gap: var(--space-3); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .perchi__si { flex: none; margin-top: .15em; color: var(--success); }
  .perchi__punto { flex: none; width: 8px; height: 8px; margin: .6em 8px 0; border-radius: 50%; background: var(--steel); }
  .perchi__col--no h3 { color: var(--muted); }
  .perchi__chir { display: flex; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--steel); border-radius: var(--r-2); background: var(--surface); }
  .perchi__ico { flex: none; color: var(--steel); }
  .perchi__aut { max-width: 34ch; font-weight: 650; text-wrap: balance; }
  @media (min-width: 1024px) {
    .perchi { grid-template-columns: 1fr 1fr; column-gap: var(--space-8); }
    .perchi__head, .perchi__chir, .perchi__aut, .perchi__cta { grid-column: 1 / -1; }
    .perchi__chir { max-width: 50rem; padding: var(--space-6); gap: var(--space-5); }
  }
</style>
