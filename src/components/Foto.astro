---
// Risolutore degli slot foto (spec E.1, E.2). Dany mette un file in src/assets/foto/ con il nome dello slot
// (qualsiasi tra jpg, jpeg, png, webp, avif) e la build genera AVIF (q55), WebP (q72) e JPG/PNG di riserva.
// File mancante: in sviluppo il "ciak" segnaposto (nome file, rapporto, lato minimo, regia);
// in produzione niente. Prima di renderizzare, i componenti chiedono hasFoto(slot) (src/lib/foto.ts)
// per passare al ripiego tipografico.
//
// Uso:
//   <Foto slot="hero-reel" sizes="(min-width: 1024px) 40vw, 62vw" loading="eager" fetchpriority="high"
//         widths={[360, 480, 720, 960, 1200]} class="hero__still" />
//   <Foto slot="storia-03-scuola" sizes="(min-width:1024px) 30vw, 70vw" ratio="libero" imgClass="print__img" />
import { getImage } from 'astro:assets';
import { getFoto, dimensioniFoto, infoSlot, normalizzaSlot } from '../lib/foto';
import Icon from './Icon.astro';

interface Props {
  /** Nome dello slot (file senza estensione). Accetta anche il nome con .jpg. */
  slot: string;
  /** Alt: default dal registro. Passa alt="" solo per immagini decorative. */
  alt?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  /** Rapporto: '4:5', '1:1', '16:9', 'libero' (originale). Default dal registro. */
  ratio?: string;
  /** object-position. Default dal registro. */
  focus?: string;
  /** Ritaglio art-directed sotto 1024px (es. '3:2'): <source media> con getImage width+height, fit cover,
   *  posizione dal focus. Da 1024px resta il rapporto `ratio`. */
  ratioMobile?: string;
  /** sizes della sorgente mobile (default 100vw). */
  sizesMobile?: string;
  /** Larghezze della sorgente mobile (default [480, 720, 1080]). */
  widthsMobile?: number[];
  /** object-position da 1024px (es. per tenere il volto fuori dalla colonna di testo). */
  focusDesktop?: string;
  /** true = caricamento differito via JS: data-srcset/data-src, src 1x1 trasparente, copia reale in <noscript>.
   *  Lo script del chiamante promuove data-* a srcset/src (vedi src/scripts/reel.js). */
  differita?: boolean;
  fit?: 'cover' | 'contain';
  /** Classe sul <picture> (e sul segnaposto). */
  class?: string;
  /** Classe sull'<img>. */
  imgClass?: string;
  /** false = in sviluppo non mostrare il segnaposto (il chiamante gestisce l'assenza). */
  segnaposto?: boolean;
  [key: `data-${string}`]: unknown;
}

const {
  slot,
  sizes = '100vw',
  widths = [360, 480, 720, 960, 1200, 1600],
  loading = 'lazy',
  fetchpriority,
  decoding = loading === 'eager' ? 'sync' : 'async',
  fit = 'cover',
  class: className,
  imgClass,
  segnaposto = true,
  ratioMobile,
  sizesMobile = '100vw',
  widthsMobile = [480, 720, 1080],
  // alt, ratio e focus: solo per l'<img> (alt) e per lo stile; mai sul <picture>.
  alt: altProp,
  ratio: ratioProp,
  focus: focusProp,
  focusDesktop,
  differita = false,
  ...rest
} = Astro.props;

const nome = normalizzaSlot(slot);
const info = infoSlot(nome);
const meta = getFoto(nome);
// Proprietà lette da una copia: leggerle dall'originale lo pubblicherebbe con gli EXIF.
const dim = dimensioniFoto(nome);
const alt = altProp ?? info?.alt ?? '';
const ratio = ratioProp ?? info?.ratio ?? 'libero';
const focus = focusProp ?? info?.focus ?? '50% 50%';
const cid = Object.fromEntries(Object.entries(rest).filter(([k]) => k.startsWith('data-astro-cid')));
const dataAttr = Object.fromEntries(Object.entries(rest).filter(([k]) => !k.startsWith('data-astro-cid')));
// scopedStyleStrategy 'class': la classe di scope del genitore (astro-xxxx) arriva dentro `class`.
// La ripetiamo sull'<img> perché i selettori del genitore su imgClass continuino a corrispondere.
const scope = String(className ?? '').split(/\s+/).filter((c) => /^astro-[a-z0-9]+$/.test(c));

if (altProp === undefined && !info) {
  console.warn(`[foto] slot "${nome}" non è nel registro src/data/foto.ts: passa un alt esplicito.`);
}

/** '4:5' -> [4, 5]; 'libero' -> null */
const parseRatio = (r: string): [number, number] | null => {
  const m = r.match(/^(\d+(?:\.\d+)?)[:/](\d+(?:\.\d+)?)$/);
  return m ? [Number(m[1]), Number(m[2])] : null;
};
const rr = parseRatio(ratio);

/** focus "50% 30%" -> gravità di sharp ("top", "left top"...): il ritaglio in build segue il soggetto. */
const gravita = (f: string) => {
  const [x, y] = f.split(/\s+/).map((v) => parseFloat(v));
  const vy = isNaN(y) ? '' : y < 40 ? 'top' : y > 60 ? 'bottom' : '';
  const vx = isNaN(x) ? '' : x < 40 ? 'left' : x > 60 ? 'right' : '';
  return [vx, vy].filter(Boolean).join(' ') || 'centre';
};
const rrM = ratioMobile ? parseRatio(ratioMobile) : null;
const MQ_MOBILE = '(max-width: 1023.98px)';
// GIF 1x1 trasparente: segnaposto delle foto differite (le dimensioni restano quelle vere, nessuno spostamento).
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

let render: null | {
  avif: string;
  webp: string;
  fallbackSrc: string;
  w: number;
  h: number;
  mobile?: { avif: string; webp: string };
} = null;

if (meta && dim) {
  const usabili = widths.filter((w) => w <= dim.width);
  const larghezze = usabili.length ? usabili : [dim.width];
  const maxW = Math.max(...larghezze);
  const h = rr ? Math.round((maxW * rr[1]) / rr[0]) : Math.round((maxW * dim.height) / dim.width);
  const comune = { src: meta, widths: larghezze, width: maxW, layout: 'none' as const, sizes };
  const fallbackFormat = dim.format === 'png' ? 'png' : 'jpg';
  const [avif, webp, fb] = await Promise.all([
    getImage({ ...comune, format: 'avif', quality: 55 }),
    getImage({ ...comune, format: 'webp', quality: 72 }),
    // Ripiego JPG/PNG: una sola larghezza. Ogni browser di destinazione usa le <source> AVIF o WebP,
    // quindi un srcset completo qui costava circa 1 KB gzip di HTML per pagina senza servire a nessuno.
    getImage({ src: meta, width: Math.min(maxW, 960), format: fallbackFormat, quality: 78 }),
  ]);
  render = {
    avif: avif.srcSet.attribute,
    webp: webp.srcSet.attribute,
    fallbackSrc: fb.src,
    w: maxW,
    h,
  };
  if (rrM) {
    // Ritaglio mobile: il lato corto della sorgente limita la larghezza massima.
    const maxMW = Math.min(dim.width, Math.floor((dim.height * rrM[0]) / rrM[1]));
    const wm = widthsMobile.filter((w) => w <= maxMW);
    const lm = wm.length ? wm : [maxMW];
    const wM = Math.max(...lm);
    const comuneM = {
      src: meta,
      widths: lm,
      width: wM,
      height: Math.round((wM * rrM[1]) / rrM[0]),
      fit: 'cover' as const,
      position: gravita(focus),
      layout: 'none' as const,
      sizes: sizesMobile,
    };
    const [am, wbm] = await Promise.all([
      getImage({ ...comuneM, format: 'avif', quality: 55 }),
      getImage({ ...comuneM, format: 'webp', quality: 72 }),
    ]);
    render.mobile = { avif: am.srcSet.attribute, webp: wbm.srcSet.attribute };
  }
}

const stileImg = [
  rr ? `aspect-ratio:${rr[0]}/${rr[1]}` : '',
  `object-fit:${fit}`,
  `object-position:${focus}`,
  focusDesktop ? `--fd:${focusDesktop}` : '',
]
  .filter(Boolean)
  .join(';');
const mostraSegnaposto = !meta && segnaposto && import.meta.env.DEV;
---

{
  render && !differita && (
    <picture class={className} data-foto={nome} {...cid} {...dataAttr}>
      {render.mobile && <source media={MQ_MOBILE} type="image/avif" srcset={render.mobile.avif} sizes={sizesMobile} />}
      {render.mobile && <source media={MQ_MOBILE} type="image/webp" srcset={render.mobile.webp} sizes={sizesMobile} />}
      <source type="image/avif" srcset={render.avif} sizes={sizes} />
      <source type="image/webp" srcset={render.webp} sizes={sizes} />
      <img
        src={render.fallbackSrc}
        width={render.w}
        height={render.h}
        alt={alt}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        class:list={['foto__img', { 'foto__img--fd': focusDesktop }, imgClass, ...scope]}
        style={stileImg}
        {...cid}
      />
    </picture>
  )
}
{
  render && differita && (
    <>
      <picture class:list={[className, 'foto--differita']} data-foto={nome} data-differita {...cid} {...dataAttr}>
        <source type="image/avif" data-srcset={render.avif} sizes={sizes} />
        <source type="image/webp" data-srcset={render.webp} sizes={sizes} />
        <img
          src={PIXEL}
          data-src={render.fallbackSrc}
          width={render.w}
          height={render.h}
          alt={alt}
          loading={loading}
          decoding="async"
          class:list={['foto__img', { 'foto__img--fd': focusDesktop }, imgClass, ...scope]}
          style={stileImg}
          {...cid}
        />
      </picture>
      <noscript>
        <picture class={className} data-foto={nome} {...cid}>
          <source type="image/avif" srcset={render.avif} sizes={sizes} />
          <source type="image/webp" srcset={render.webp} sizes={sizes} />
          <img
            src={render.fallbackSrc}
            width={render.w}
            height={render.h}
            alt={alt}
            loading={loading}
            decoding="async"
            class:list={['foto__img', { 'foto__img--fd': focusDesktop }, imgClass, ...scope]}
            style={stileImg}
            {...cid}
          />
        </picture>
      </noscript>
    </>
  )
}
{
  mostraSegnaposto && (
    <div
      class:list={['foto-slate', 'grain', className]}
      style={rr ? `aspect-ratio:${rr[0]}/${rr[1]}` : 'aspect-ratio:4/5'}
      data-foto-mancante={nome}
      role="img"
      aria-label={`Segnaposto: ${nome}`}
      {...cid}
    >
      <Icon name="curva" size={32} />
      <p class="foto-slate__riga foto-slate__file">{nome}.jpg</p>
      <p class="foto-slate__riga">
        {info ? `${info.ratio} · min ${info.min} · ${info.priorita}` : 'slot fuori registro'}
      </p>
      {info && <p class="foto-slate__riga foto-slate__regia">{info.regia}</p>}
    </div>
  )
}

<style>
  .foto__img {
    width: 100%;
    height: auto;
  }
  /* Senza JS la copia in <noscript> prende il posto della foto differita. */
  :global(html:not(.js)) .foto--differita { display: none; }
  @media (min-width: 1024px) {
    .foto__img--fd { object-position: var(--fd) !important; }
  }
  .foto-slate {
    --grain-opacity: .06;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-6) var(--space-5);
    background: var(--night-surface);
    color: var(--night-muted);
    outline: 1px dashed var(--night-line-strong);
    outline-offset: -12px;
    text-align: center;
    overflow: hidden;
  }
  .foto-slate__riga {
    position: relative;
    z-index: 2;
    font-size: var(--fs-micro);
    font-weight: 620;
    letter-spacing: .08em;
    line-height: 1.35;
    text-transform: uppercase;
    max-width: 34ch;
  }
  .foto-slate__file {
    color: var(--night-text);
    text-transform: none;
    letter-spacing: .02em;
  }
  .foto-slate__regia {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
</style>
