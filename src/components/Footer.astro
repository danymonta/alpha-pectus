---
// Footer (spec H, F.8, D33, D43). Proprietario: engineer "bofu". Night.
// Ordine: divisorio piatto, lockup (non è un link) e descrizione, riga firma, invito a seguire, righe social
// (Instagram, YouTube: target _blank, rel "me noopener", evento outbound), #fonti (lista numerata da fontiPubblicate(),
// nuova scheda, rel noopener, mai nofollow, link di ritorno al primo richiamo #rif-N-1), avvertenza medica,
// firma con data, valori, riga legale (i dati aziendali escono solo se valorizzati in AZIENDA), "Preferenze cookie"
// solo con PIXEL_ID. Lo spazio per la barra fissa su mobile lo riserva .riserva-sticky (non mettere padding su .footer).
import Curva from './Curva.astro';
import Lockup from './Lockup.astro';
import Icon, { type IconName } from './Icon.astro';
import { footer as ft, fontiPubblicate, confronto } from '../data/pagina';
import { SOCIAL, AZIENDA, PIXEL_ID, PERCORSO_ALPHA_URL } from '../data/site.mjs';
import { dataIt } from '../lib/testo';

interface Props {
  /** true sulle pagine senza note (404, privacy): niente #fonti, i link di ritorno non avrebbero destinazione. */
  compatto?: boolean;
}
const { compatto = false } = Astro.props;

// Fonti richiamate da almeno una nota nella pagina (solo #operazione-o-allenamento cita fonti):
// per queste esiste #rif-N-1 e la voce porta il link di ritorno.
const citate = new Set([
  ...confronto.inChiaro.definizione.fonti,
  ...confronto.tabella.righe.flatMap((r) => r.operazione.fonti),
  ...confronto.adulti.fonti,
]);
const fonti = fontiPubblicate();
const L = ft.legale;
const legale = [
  L.copyright,
  AZIENDA.ragioneSociale,
  AZIENDA.partitaIva && `${L.pIvaPrefisso} ${AZIENDA.partitaIva}`,
  AZIENDA.email,
].filter(Boolean) as string[];
---

<footer class="footer mode-night riserva-sticky" data-sticky-hide>
  <Curva da="golden" a="night" profondita="piatta" />
  <div class="wrap footer__in">
    <div class="footer__brand">
      <Lockup class="footer__lockup" />
      <p class="t-muted">{ft.descrizione}</p>
      <p class="footer__firma">{ft.firma}</p>
      <p class="footer__seguimi">{ft.seguimi}</p>
      <ul role="list" class="footer__social">
        {ft.social.map((s) => {
          const rete = SOCIAL[s.rete as keyof typeof SOCIAL];
          // "Instagram · @_danymonta": nome della rete sopra, profilo sotto.
          const [nome, profilo] = s.etichetta.split(' · ');
          return (
            <li>
              <a class="footer__link" href={rete.url} target="_blank" rel="me noopener" data-evt="outbound" data-evt-dest={s.dest}>
                <Icon name={s.rete as IconName} class="footer__glyph" />
                <span class="footer__rete">
                  <span>{nome}</span> {profilo && <span class="footer__prof">{profilo}</span>}
                </span>
                <Icon name="arrow-right" class="footer__freccia" />
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    {!compatto && (
    <section id={ft.fonti.id} class="footer__fonti" aria-labelledby="fonti-h2">
      <h2 id="fonti-h2" class="caps footer__fh">{ft.fonti.h2}</h2>
      <ol role="list" class="footer__ol">
        {fonti.map((f) => {
          const cit = `${f.editore}, ${f.titolo}${f.anno ? `, ${f.anno}` : ''}`;
          return (
            <li id={`fonte-${f.numero}`} class="footer__fi">
              <span class="footer__n">[{f.numero}]</span>
              {f.url ? (
                <a href={f.url} target="_blank" rel="noopener" class="footer__fonte">{cit}</a>
              ) : (
                <span>{cit}</span>
              )}
              {citate.has(f.chiave) && (
                <a href={`#rif-${f.numero}-1`} class="footer__torna" title={ft.fonti.ritorno}>
                  <Icon name="arrow-down" size={18} class="footer__su" />
                  <span class="visually-hidden">{ft.fonti.ritorno}</span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </section>
    )}

    <div class="footer__base">
      <p class="footer__disc">{ft.disclaimer}</p>
      <p>
        {ft.bylinePrima} <time datetime={ft.data}>{dataIt(ft.data)}</time>.
      </p>
      <p class="caps footer__valori">{ft.valori.join(' · ')}</p>
      <ul role="list" class="footer__legale">
        {legale.map((x) => <li>{x}</li>)}
        <li><a href={L.privacyHref}>{L.privacy}</a></li>
        <li>
          <a href={PERCORSO_ALPHA_URL} target="_blank" rel="noopener" data-evt="outbound" data-evt-dest="pa">{L.sitoPA}</a>
        </li>
        {PIXEL_ID && (
          <li><button type="button" class="footer__pref" data-consenso-apri>{ft.preferenzeCookie}</button></li>
        )}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer__in { display: grid; gap: var(--space-8); padding-block: var(--space-9) var(--space-7); }
  .footer__brand { display: grid; gap: var(--space-4); align-content: start; }
  .footer__lockup { margin-bottom: var(--space-2); }
  .footer__firma { font-family: var(--font-display); font-size: var(--fs-lead); font-stretch: 82%; font-weight: 760; line-height: 1.15; letter-spacing: -.01em; }
  .footer__seguimi { margin-top: var(--space-4); }
  .footer__social { display: grid; gap: var(--space-3); }
  .footer__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: 0 var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-2);
    font-weight: 650;
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease);
  }
  .footer__link:hover { border-color: var(--amber); }
  .footer__glyph { flex: none; }
  .footer__rete { display: grid; line-height: 1.3; }
  .footer__prof { color: var(--muted); font-weight: 400; font-size: var(--fs-small); }
  .footer__freccia { flex: none; margin-left: auto; color: var(--accent-text); transition: transform var(--dur-1) var(--ease); }
  .footer__link:hover .footer__freccia { transform: translateX(4px); }

  .footer__fh { color: var(--muted); font-family: var(--font-sans); font-stretch: 100%; line-height: 1.2; }
  .footer__ol { display: grid; gap: var(--space-1); margin-top: var(--space-4); font-size: var(--fs-small); line-height: 1.5; }
  .footer__fi { display: grid; grid-template-columns: 2.6em 1fr var(--tap); align-items: start; padding: var(--space-2) 0 var(--space-2) var(--space-3); margin-inline: calc(-1 * var(--space-3)); border-radius: var(--r-1); scroll-margin-top: 30vh; }
  .footer__fi:target { background: var(--surface); box-shadow: inset 2px 0 var(--amber); }
  .footer__n { color: var(--accent-text); font-variant-numeric: tabular-nums; font-weight: 650; }
  .footer__fonte { text-decoration-color: var(--line-strong); }
  .footer__fonte:hover { text-decoration-color: currentColor; }
  .footer__torna { display: grid; place-items: center; grid-column: 3; height: var(--tap); margin-top: -12px; color: var(--muted); border-radius: var(--r-1); }
  .footer__torna:hover { color: var(--text); }
  .footer__su { transform: rotate(180deg); }
  .footer__base { display: grid; gap: var(--space-3); padding-top: var(--space-6); border-top: 1px solid var(--line); font-size: var(--fs-small); line-height: 1.5; color: var(--muted); }
  .footer__disc { max-width: var(--measure); }
  .footer__valori { margin-block: var(--space-3); }
  .footer__legale { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-2); }
  /* Separatore in coda: se la riga va a capo, la nuova riga non comincia con un punto. */
  .footer__legale li:not(:last-child)::after { content: "·"; margin-left: var(--space-2); }
  .footer__legale a, .footer__pref { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--text); text-decoration: underline; text-decoration-color: var(--line-strong); }

  @media (min-width: 768px) {
    .footer__social { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .footer__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); padding-top: var(--space-10); }
    .footer__brand { grid-column: 1 / 7; }
    .footer__fonti { grid-column: 8 / -1; }
    .footer__base { grid-column: 1 / -1; }
  }
</style>
