---
// CTA primaria (spec G.1, G.2, D26 a D28). L'unico elemento con riempimento ambra della pagina.
// Etichetta fissa ovunque: "Scrivimi PETTO su Instagram". Link semplice, mai target="_blank".
// href in HTML: DM_URL?ref=pe_<placement> (funziona senza JS); src/scripts/cta.js (piattaforma) aggiunge
// _<src>_<variante>, copia PETTO negli appunti, invia dm_click e su desktop apre il pannello QR.
//
// Uso:
//   <CtaDm placement="metodo" leadIn="Ora sai cosa serve. Vuoi sapere da dove partiresti tu?" />   inline, frizione full
//   <CtaDm placement="offerta" friction="full+fallback" />
//   <CtaDm placement="hero" variant="link" leadIn="Vuoi parlarne subito?" friction="short" inline={false} />
//   <CtaDm placement="sticky" size="sm" friction="short" inline={false} />
import { DM_URL, KEYWORD, FRIZIONE, REF_PREFIX } from '../data/site.mjs';
import Icon from './Icon.astro';

interface Props {
  /** Diventa ref=pe_<placement>: hero, metodo, casi, perte, offerta, finale, sticky, header. */
  placement: string;
  /** Una riga sopra il bottone (l'unica parte che può cambiare). */
  leadIn?: string;
  /** micro: una riga sola (barra fissa mobile). */
  friction?: 'none' | 'micro' | 'short' | 'full' | 'full+fallback';
  /** button: bottone ambra. link: link testuale dell'hero (testo bone, sottolineatura ambra). */
  variant?: 'button' | 'link';
  size?: 'sm' | 'md' | 'lg';
  /** true = CTA inline (data-cta-inline: la barra fissa si nasconde quando è visibile). Default true per variant button. */
  inline?: boolean;
  class?: string;
  id?: string;
  [key: `data-${string}`]: unknown;
}

const {
  placement,
  leadIn,
  variant = 'button',
  size = 'md',
  class: className,
  id,
  ...rest
} = Astro.props;
const friction = Astro.props.friction ?? (variant === 'link' ? 'short' : 'full');
const inline = Astro.props.inline ?? variant === 'button';

if (!/^[a-z0-9-]+$/.test(placement)) {
  throw new Error(`CtaDm: placement "${placement}" non valido (solo minuscole, cifre, trattino)`);
}
const ref = `${REF_PREFIX}${placement}`;
const href = `${DM_URL}?ref=${ref}`;
const cid = Object.fromEntries(Object.entries(rest).filter(([k]) => k.startsWith('data-astro-cid')));
---

<div
  class:list={['cta-dm', `cta-dm--${variant}`, className]}
  id={id}
  data-cta-inline={inline ? '' : undefined}
  {...cid}
>
  {
    variant === 'link' ? (
      <p class="cta-dm__linkline">
        {leadIn && <span class="cta-dm__leadin">{leadIn} </span>}
        <a class="link-dm" href={href} data-dm data-ref={ref} data-evt="dm_click" data-evt-cta={placement}>
          Scrivimi {KEYWORD} su Instagram
        </a>
      </p>
    ) : (
      <>
        {leadIn && <p class="cta-dm__lead">{leadIn}</p>}
        <a
          class:list={['btn-dm', { 'btn-dm--sm': size === 'sm', 'btn-dm--lg': size === 'lg' }]}
          href={href}
          data-dm
          data-ref={ref}
          data-evt="dm_click"
          data-evt-cta={placement}
        >
          <Icon name="instagram" class="btn-dm__glyph" size={20} />
          <span>Scrivimi</span> <span class="btn-dm__chip">{KEYWORD}</span> <span>su Instagram</span>
        </a>
      </>
    )
  }
  {friction !== 'none' && (
    <p class:list={['cta-dm__friction', { 'cta-dm__friction--micro': friction === 'micro' }]} data-nosnippet>
      {friction === 'micro' ? FRIZIONE.micro : friction === 'short' ? FRIZIONE.short : FRIZIONE.full}
    </p>
  )}
  {friction === 'full+fallback' && <p class="cta-dm__friction cta-dm__fallback" data-nosnippet>{FRIZIONE.fallback}</p>}
</div>

<script>
  import '../scripts/cta.js';
</script>

<style>
  .cta-dm {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .cta-dm--button { width: 100%; }
  .cta-dm__lead {
    font-size: var(--fs-lead);
    line-height: 1.35;
    font-weight: 650;
    max-width: 32ch;
    text-wrap: balance;
  }
  .cta-dm__linkline { font-size: var(--fs-body); line-height: 1.5; }
  .cta-dm__leadin { color: var(--muted); }
  .cta-dm__friction {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
    max-width: 52ch;
  }
  /* Una riga: la barra fissa resta sotto i 88px (--sticky-h). */
  .cta-dm__friction--micro { line-height: 1.2; max-width: none; }
</style>
