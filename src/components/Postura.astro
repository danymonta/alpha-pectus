---
// La postura #postura (spec C.6, D19, D20, D58). Paper. Nessuna CTA.
// H3 #specchio: la prova dello specchio. Coppia di foto 4:5 con un controllo segmentato fatto di due radio:
// funziona solo con CSS (:checked), dissolvenza --dur-2. Senza le due foto il blocco resta solo testo.
// Il payoff è sempre visibile; "Fatto. L'ho visto." (e, se confermato, "Non hai notato differenze?") sono <details> nativi.
// H3 #esercizi (data-evt-zone="esercizi"): passaggio d'apertura fisso (GEO), tre Esercizio, le due note, poi la svolta.
import Section from './Section.astro';
import Foto from './Foto.astro';
import Esercizio from './Esercizio.astro';
import Icon from './Icon.astro';
import { hasFoto } from '../lib/foto';
import { postura, CHIPS_ESERCIZIO } from '../data/pagina';

const { specchio: sp, esercizi: es, svolta } = postura;
const conFoto = hasFoto(sp.foto.chiuse) && hasFoto(sp.foto.aperte);
const stati = [
  { v: 'chiuse', label: sp.toggle.chiuse, slot: sp.foto.chiuse },
  { v: 'aperte', label: sp.toggle.aperte, slot: sp.foto.aperte },
] as const;
// Le chip sono le stesse per i tre esercizi (CHIPS_ESERCIZIO nei dati): si rendono una volta sola.
const chips = CHIPS_ESERCIZIO;
const ICONE = ['calendar', 'band'] as const;
---

<Section id={postura.id} mode="paper" zone="mofu" labelledby={`${postura.id}-h2`} data-evt-zone="postura">
  <div class="wrap postura__p postura__w">
    <header class="postura__testa postura__p" style="--g:var(--space-4)">
      <p class="eyebrow">{postura.eyebrow}</p>
      <h2 id={`${postura.id}-h2`}>{postura.h2}</h2>
      <p class="t-lead">{postura.intro}</p>
    </header>

    {/* Prova dello specchio. Con le foto: controllo segmentato (due radio in una pillola), foto 4:5, payoff sempre
        visibile, poi le istruzioni. Lo scambio delle foto è solo CSS (:has sul blocco). Senza foto: solo testo. */}
    <div id={sp.id} class:list={['postura__blocco postura__specchio', { 'postura__specchio--foto': conFoto }]}>
      <h3 class="postura__h3">{sp.h3}</h3>
      {
        conFoto && (
          <fieldset class="postura__seg" data-specchio>
            <legend class="visually-hidden">{sp.toggle.ariaGruppo}</legend>
            {stati.map((s, i) => (
              <>
                <input
                  type="radio"
                  name="specchio"
                  id={`specchio-${s.v}`}
                  value={s.v}
                  class="visually-hidden"
                  checked={i === 0}
                />
                <label for={`specchio-${s.v}`} class="postura__l">{s.label}</label>
              </>
            ))}
          </fieldset>
        )
      }
      {
        conFoto && (
          <div class="postura__foto">
            {stati.map((s) => (
              <Foto slot={s.slot} ratio="4:5" sizes="(min-width: 1024px) 460px, 100vw" widths={[360, 480, 720, 960]} />
            ))}
          </div>
        )
      }
      <p class="t-lead postura__payoff">{sp.payoff}</p>
      <div class="postura__testo postura__p" style="--g:var(--space-4)">
        <ol class="postura__p" style="--g:var(--space-3)" role="list">
          {sp.istruzioni.map((r) => <li class="postura__passo">{r}</li>)}
        </ol>
        <details>
          <summary class="btn-outline" data-evt="mirror_done">{sp.fatto.summary}</summary>
          <p class="postura__rivela">{sp.fatto.testo}</p>
        </details>
        {
          sp.nonNotato && (
            <details>
              <summary class="link-text postura__sum" data-evt="mirror_nodiff">{sp.nonNotato.summary}</summary>
              <p class="postura__rivela">{sp.nonNotato.testo}</p>
            </details>
          )
        }
      </div>
    </div>

    <div id={es.id} class="postura__blocco postura__p" style="--g:var(--space-5)" data-evt-zone="esercizi">
      <h3 class="postura__h3">{es.h3}</h3>
      <p class="t-lead postura__testa">{es.apertura}</p>
      {/* Le due indicazioni valgono per tutti e tre gli esercizi: una volta sola, sotto l'apertura. */}
      {
        chips.length > 0 && (
          <ul class="postura__chips" role="list">
            {chips.map((c, i) => (
              <li class="postura__chip t-small">
                <Icon name={ICONE[i] ?? 'check'} size={18} />
                {c}
              </li>
            ))}
          </ul>
        )
      }
      <ol class="postura__lista" role="list">
        {
          es.lista.map((e) => (
            <li>
              <Esercizio esercizio={e} etichette={es.video} />
            </li>
          ))
        }
      </ol>
      <div class="postura__note">
        {
          es.note.map((n) => (
            <p class="postura__nota t-small">
              <strong>{n.titolo}</strong> {n.testo}
            </p>
          ))
        }
      </div>
    </div>

    <div class="postura__testa postura__p" style="--g:var(--space-4)">
      <p class="t-h2">{svolta.titolo}</p>
      <p class="t-lead">{svolta.testo}</p>
    </div>
  </div>
</Section>

<script>
  import '../scripts/postura.js';
</script>

<style>
  .postura__p { display: grid; align-content: start; gap: var(--g); }
  .postura__w { --g: var(--space-7); }
  .postura__testa { max-width: 46rem; }
  .postura__testo { max-width: 40rem; }
  .postura__passo { padding-left: var(--space-4); border-left: 2px solid var(--line-strong); }
  .postura__rivela { margin-top: var(--space-4); }
  .postura__sum { list-style: none; cursor: pointer; }
  .postura__sum::-webkit-details-marker { display: none; }

  /* Sottoblocchi #specchio e #esercizi: filetto in alto e H3 più presente. */
  .postura__blocco { padding-top: var(--space-6); border-top: 1px solid var(--line-strong); }
  .postura__h3 { font-family: var(--font-display); font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem); font-stretch: 82%; font-weight: 700; line-height: 1.15; }

  /* Specchio: impilato su mobile (controllo, foto, payoff, istruzioni). */
  .postura__specchio { display: grid; gap: var(--space-5); }
  .postura__payoff { color: var(--text); max-width: 40rem; }
  .postura__seg {
    display: flex;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
  }
  .postura__l {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-lg);
    padding: 0 var(--space-3);
    border-radius: 99px;
    font-size: var(--fs-small);
    font-weight: 650;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: background-color var(--dur-2) var(--ease), color var(--dur-2) var(--ease);
  }
  :checked + .postura__l { background: var(--text); color: var(--bg); }
  :focus-visible + .postura__l { outline: 2px solid var(--focus); outline-offset: 3px; }
  .postura__foto { display: grid; border-radius: var(--r-2); overflow: hidden; }
  .postura__foto > * { grid-area: 1 / 1; transition: opacity var(--dur-2) var(--ease); }
  .postura__foto > :last-child,
  .postura__specchio:has(#specchio-aperte:checked) .postura__foto > :first-child { opacity: 0; }
  .postura__specchio:has(#specchio-aperte:checked) .postura__foto > :last-child { opacity: 1; }

  /* Esercizi: le chip una volta sola. */
  .postura__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .postura__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: 99px;
  }
  .postura__lista, .postura__note { display: grid; gap: var(--space-7); }
  .postura__lista { gap: var(--space-5); }
  .postura__note { gap: var(--space-4); }
  .postura__nota { padding: var(--space-5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-2); }

  @media (min-width: 768px) {
    .postura__w { --g: var(--space-9); }
    .postura__note { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    /* Specchio: foto in 1 a 5; controllo, payoff e istruzioni in 7 a 12, allineati in alto.
       Senza foto: payoff a sinistra, istruzioni a destra. */
    .postura__specchio { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); row-gap: var(--space-5); align-items: start; }
    .postura__specchio > * { grid-column: 7 / -1; }
    .postura__specchio > .postura__h3 { grid-column: 1 / -1; }
    .postura__specchio:not(.postura__specchio--foto) > .postura__payoff { grid-column: 1 / 6; }
    .postura__specchio:not(.postura__specchio--foto) > .postura__testo { grid-row: 2; }
    .postura__specchio--foto { grid-template-rows: auto auto auto auto 1fr; }
    .postura__specchio--foto > .postura__foto { grid-column: 1 / 6; grid-row: 2 / 6; }
    .postura__seg { max-width: 28rem; }
    .postura__lista { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  }
</style>
