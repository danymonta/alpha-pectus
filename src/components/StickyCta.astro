---
// Barre fisse della CTA candidatura (spec G.3). Proprietario: piattaforma.
// - Mobile (sotto 768px): barra in basso, bottone 52px + riga di frizione breve, safe area.
// - Desktop (1024px e oltre): barra compatta in alto con lockup a sinistra e CTA a destra.
// Tutto data-nosnippet. Senza JS le barre restano nascoste (hidden). Show e hide: src/scripts/sticky.js.
import CtaDm from './CtaDm.astro';
import Lockup from './Lockup.astro';
import { ARIA_STICKY } from '../data/site.mjs';
const ariaBarra = ARIA_STICKY.barra;
---

<aside class="sticky-cta sticky-cta--basso mode-night" aria-label={ariaBarra} data-sticky data-nosnippet hidden>
  <CtaDm placement="sticky" size="sm" friction="micro" inline={false} class="sticky-cta__cta" />
</aside>

<aside class="sticky-cta sticky-cta--alto mode-night" aria-label={ariaBarra} data-sticky data-nosnippet hidden>
  <div class="wrap sticky-cta__in">
    <Lockup />
    <CtaDm placement="header" size="sm" friction="none" inline={false} class="sticky-cta__cta" />
  </div>
</aside>



<script>
  import '../scripts/sticky.js';
</script>

<style>
  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    z-index: 50;
    background: var(--sticky-bg);
    transition: transform var(--dur-2) var(--ease);
  }
  .sticky-cta--basso {
    bottom: 0;
    border-top: 1px solid var(--line);
    /* Altezza reale = --sticky-h (tokens.css): bordo 1 + 8 + bottone 52 + 3 + una riga di frizione + 6. */
    padding: var(--space-2) max(var(--space-4), env(safe-area-inset-right)) calc(6px + env(safe-area-inset-bottom)) max(var(--space-4), env(safe-area-inset-left));
    transform: translateY(calc(100% + 1px));
  }
  .sticky-cta--basso > .sticky-cta__cta { gap: 3px; }
  .sticky-cta--alto {
    top: 0;
    display: none;
    background: var(--header-bar-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transform: translateY(calc(-100% - 1px));
  }
  .sticky-cta__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: calc(var(--bar-desktop-h) - 1px);
  }
  .sticky-cta__in > .sticky-cta__cta { width: auto; }
  .sticky-cta.is-on { transform: none; }
  @media (min-width: 768px) {
    .sticky-cta--basso { display: none; }
  }
  @media (min-width: 1024px) {
    .sticky-cta--alto { display: block; }
  }

</style>
