---
// Quiz "che petto hai" (/quiz/). Pagina a cui mandare le persone: introduzione, 11 domande a passi, contatti,
// risultato personalizzato e bottone WhatsApp (wa.me) con il messaggio già scritto. Le risposte si salvano a ogni
// passo su Supabase tramite /api/quiz (functions/api/quiz.js). Fuori dalla sitemap e noindex.
// Domande, risultato e priorità del lead: src/data/quiz.mjs. Lo script che la pilota: src/scripts/quiz.js.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { PASSI } from '../../data/quiz.mjs';
import { STATS, WHATSAPP_NUMERO, CANDIDATURA_URL } from '../../data/site.mjs';

const totale = PASSI.length;
---

<Base
  title="Che petto hai? Il test di Dany | Percorso Alpha Pectus"
  description="Un test gratuito di due minuti per capire che tipo di petto scavato hai, cosa incide su postura e respiro e da dove partire."
  path="/quiz/"
  noindex
  schema={false}
>
  <Header />
  <main id="main" class="quiz mode-golden grain" data-quiz data-wa={WHATSAPP_NUMERO} data-cand={CANDIDATURA_URL}>
    <div class="wrap quiz__in">
      <section class="quiz__intro" data-intro>
        <p class="eyebrow">Gratis · 2 minuti · Dany Monta</p>
        <h1 class="quiz__h1">Che petto scavato hai, e cosa puoi fare davvero?</h1>
        <p class="quiz__lead">
          Rispondi a {totale} domande. Alla fine ti dico che tipo di petto hai, cosa incide su postura e respiro e da
          dove si parte, in base a quello che mi hai scritto.
        </p>
        <button type="button" class="btn-dm quiz__start" data-start>
          <span>Fai il test del petto</span>
          <Icon name="arrow-right" class="btn-dm__glyph" size={20} />
        </button>
        <p class="quiz__micro">Due minuti. Gratis, senza impegno.</p>

        <div class="quiz__dueblocchi">
          <div class="quiz__box">
            <h2 class="quiz__h2">Questo test è per te se</h2>
            <ul>
              <li>Hai il petto scavato e vuoi capire che tipo è.</li>
              <li>Ti alleni, ma il petto non cambia come dovrebbe.</li>
              <li>Hai le spalle chiuse, il fiato corto o la schiena che tira.</li>
              <li>Hai valutato l’operazione e cerchi un’alternativa seria.</li>
            </ul>
          </div>
          <div class="quiz__box quiz__box--no">
            <h2 class="quiz__h2">Non fa per te se</h2>
            <ul>
              <li>Cerchi una promessa di risultato in poche settimane.</li>
              <li>Cerchi un sostituto di una visita medica.</li>
            </ul>
          </div>
        </div>

        <p class="quiz__chi">
          Sono Dany. Ho il pectus excavatum, ci lavoro dal {STATS.annoInizio} e dal {STATS.annoAiuto} aiuto altre
          persone. Il test è una lettura indicativa fatta da me, non una diagnosi.
        </p>
      </section>

      <section class="quiz__stage" data-stage hidden aria-live="polite"></section>
      <noscript>
        <p class="quiz__noscript">
          Il test ha bisogno di JavaScript. Se non riesci ad attivarlo, <a href={CANDIDATURA_URL}>candidati qui</a>.
        </p>
      </noscript>
    </div>
  </main>
  <Footer compatto />
</Base>

<script>
  import '../../scripts/quiz.js';
</script>

<style is:global>
  .quiz { padding-block: var(--space-8) var(--space-9); min-height: 80svh; }
  .quiz__in { display: grid; gap: var(--space-7); max-width: 46rem; }
  .quiz__intro { display: grid; gap: var(--space-5); }
  .quiz__h1 {
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 760;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: -0.02em;
  }
  .quiz__lead { font-size: var(--fs-lead); line-height: 1.45; color: var(--muted); }
  .quiz__micro { font-size: var(--fs-small); color: var(--muted); }
  .quiz__start { justify-self: start; }
  .quiz__dueblocchi { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
  .quiz__box { display: grid; align-content: start; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--r-3); background: var(--surface); }
  .quiz__box ul { display: grid; gap: var(--space-2); padding: 0; list-style: none; color: var(--muted); font-size: var(--fs-small); line-height: 1.5; }
  .quiz__box li { padding-left: var(--space-5); position: relative; }
  .quiz__box li::before { content: ''; position: absolute; left: 0; top: .6em; width: 10px; height: 2px; background: var(--accent-text); }
  .quiz__box--no li::before { background: var(--steel); }
  .quiz__h2 { font-family: var(--font-display); font-stretch: 82%; font-weight: 760; font-size: var(--fs-h3); line-height: var(--lh-h3); }
  .quiz__chi { font-size: var(--fs-small); color: var(--muted); max-width: 52ch; }
  .quiz__noscript { padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--r-2); }

  /* Barra superiore: indietro, blocco, progresso */
  .qz-top { display: grid; gap: var(--space-3); margin-bottom: var(--space-5); }
  .qz-top__riga { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); font-size: var(--fs-micro); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .qz-back svg { display: inline-block; }
  .qz-back { min-height: var(--tap); padding-inline: 0; font-weight: 650; letter-spacing: .06em; color: var(--text); }
  .qz-bar { display: block; height: 3px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .qz-bar > span { display: block; height: 100%; background: var(--amber); transition: width var(--dur-2) var(--ease); }

  .qz-q { display: grid; gap: var(--space-5); }
  [data-stage] [tabindex='-1']:focus { outline: none; }
  .qz-q__h { font-family: var(--font-display); font-stretch: 82%; font-weight: 760; font-size: var(--fs-slide); line-height: var(--lh-slide); letter-spacing: -0.015em; }
  .qz-q__sub { color: var(--muted); max-width: 52ch; }
  .qz-q__tag { justify-self: start; padding: 4px 10px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: var(--fs-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--accent-text); }

  .qz-opz { display: grid; gap: var(--space-2); }
  .qz-op {
    display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: 56px;
    padding: var(--space-3) var(--space-4); text-align: left; line-height: 1.35;
    border: 1px solid var(--line-strong); border-radius: var(--r-2); background: transparent; color: var(--text);
    transition: border-color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease);
  }
  .qz-op:hover { border-color: var(--text); }
  .qz-op:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .qz-op[aria-pressed='true'], .qz-op.is-on { border-color: var(--amber); background: rgb(120 0 0 / .35); }
  .qz-op__box { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border: 2px solid var(--line-strong); border-radius: 5px; }
  .qz-op[aria-pressed='true'] .qz-op__box { background: var(--amber); border-color: var(--amber); color: var(--ink); }

  .qz-petti { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .qz-petto { display: grid; gap: var(--space-2); align-content: start; padding: var(--space-3); text-align: left; border: 1px solid var(--line-strong); border-radius: var(--r-3); background: var(--surface); color: var(--text); transition: border-color var(--dur-1) var(--ease); }
  .qz-petto:hover { border-color: var(--text); }
  .qz-petto:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .qz-petto.is-on { border-color: var(--amber); background: rgb(120 0 0 / .35); }
  .qz-petto svg { width: 100%; height: auto; color: var(--text); }
  .qz-petto strong { font-weight: 700; line-height: 1.25; }
  .qz-petto span { font-size: var(--fs-small); color: var(--muted); line-height: 1.4; }

  .qz-num { display: flex; align-items: center; gap: var(--space-3); border: 1px solid var(--line-strong); border-radius: var(--r-2); background: var(--bg); padding-inline: var(--space-4); }
  .qz-num:focus-within { border-color: var(--amber); }
  .qz-num input { flex: 1; min-width: 0; min-height: 64px; border: 0; background: transparent; font-size: 2rem; font-weight: 760; outline: none; }
  .qz-num span { color: var(--muted); font-weight: 650; }
  .qz-hint { font-size: var(--fs-small); color: var(--muted); }
  .qz-err { color: var(--verdict); font-size: var(--fs-small); font-weight: 650; }

  .qz-nav { position: sticky; bottom: 0; display: grid; padding-block: var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 70%, transparent); }
  .qz-nav .btn-dm[disabled] { opacity: .45; cursor: not-allowed; }

  /* Contatti */
  .qz-form { display: grid; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--r-3); background: var(--surface); }
  .qz-form label.qz-lab { display: grid; gap: var(--space-2); font-weight: 650; }
  .qz-form input[type='text'], .qz-form input[type='email'], .qz-form input[type='tel'] {
    width: 100%; min-height: 52px; padding: var(--space-3) var(--space-4); border: 1px solid var(--line-strong); border-radius: var(--r-2);
    background: var(--bg); color: var(--text); font: inherit; font-size: 1rem; font-weight: 400;
  }
  .qz-form input:focus { border-color: var(--amber); outline: none; }
  .qz-form .is-err input { border-color: var(--verdict); }
  .qz-check { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--fs-small); line-height: 1.5; color: var(--muted); cursor: pointer; }
  .qz-check input { flex: none; width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--brand); }
  .qz-check a { color: var(--text); text-decoration: underline; }
  .qz-lock { display: grid; gap: var(--space-2); padding: 0; list-style: none; color: var(--muted); }
  .qz-lock li { display: flex; align-items: center; gap: var(--space-3); }
  .qz-lock svg { flex: none; color: var(--accent-text); }
  .qz-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Caricamento */
  .qz-load { display: grid; gap: var(--space-4); padding-block: var(--space-8); }
  .qz-load li { display: flex; align-items: center; gap: var(--space-3); color: var(--muted); font-size: var(--fs-lead); transition: color var(--dur-2) var(--ease); }
  .qz-load li.is-on { color: var(--text); }
  .qz-load i { flex: none; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--line-strong); }
  .qz-load li.is-on i { background: var(--amber); border-color: var(--amber); }

  /* Risultato */
  .qz-res { display: grid; gap: var(--space-6); }
  .qz-res__h { font-family: var(--font-display); font-stretch: 82%; font-weight: 760; font-size: var(--fs-h2); line-height: var(--lh-h2); letter-spacing: -0.02em; }
  .qz-card { display: grid; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--r-3); background: var(--surface); }
  .qz-card h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); font-stretch: 82%; font-weight: 760; }
  .qz-card p { color: var(--muted); }
  .qz-card--medico { border-left: 3px solid var(--steel); }
  .qz-meter { display: grid; gap: var(--space-2); }
  .qz-meter__bar { display: block; height: 10px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .qz-meter__bar > span { display: block; height: 100%; background: linear-gradient(to right, var(--phase-2), var(--amber)); }
  .qz-meter__lab { display: flex; justify-content: space-between; font-size: var(--fs-small); color: var(--muted); }
  .qz-lista { display: grid; gap: var(--space-3); padding: 0; list-style: none; }
  .qz-lista li { padding-left: var(--space-5); position: relative; color: var(--muted); line-height: 1.5; }
  .qz-lista li::before { content: ''; position: absolute; left: 0; top: .65em; width: 10px; height: 2px; background: var(--accent-text); }
  .qz-sez { display: grid; gap: var(--space-3); }
  .qz-sez > h3 { font-family: var(--font-display); font-stretch: 82%; font-weight: 760; font-size: var(--fs-h3); line-height: var(--lh-h3); }
  .qz-cta { display: grid; gap: var(--space-4); padding: var(--space-5); border: 2px solid var(--amber); border-radius: var(--r-3); background: var(--surface); }
  .qz-bolla { justify-self: end; max-width: 92%; padding: var(--space-3) var(--space-4); border-radius: 16px 16px 4px 16px; background: #d9fdd3; color: #171412; font-size: var(--fs-small); line-height: 1.45; }
  .qz-wa { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); min-height: 64px; padding: var(--space-3) var(--space-5); border-radius: var(--r-btn); background: #1f8f4e; color: #fff; font-weight: 760; font-size: 1.125rem; text-decoration: none; }
  .qz-wa:hover { background: #26a65a; }
  .qz-wa:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }
  .qz-alt { font-size: var(--fs-small); color: var(--muted); }
  .qz-alt a { color: var(--text); }
  .qz-disc { font-size: var(--fs-micro); color: var(--muted); }

  @media (min-width: 720px) {
    .quiz__dueblocchi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .qz-petti { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .quiz__in { max-width: 52rem; }
  }
</style>
