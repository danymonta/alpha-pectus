---
// Quiz Petto Scavato: landing (spec 7) e quiz a passi (spec 8, 10) nella stessa pagina, tema chiaro.
// Il quiz parte dal pulsante "Inizia il quiz" e naviga con ?step=N (script: src/scripts/quiz.js).
// Il risultato sta in /risultato/?t=<token>. Fuori dalla sitemap e noindex finché non si decide la messa online (spec 15.5).
// Asset reali da fornire (foto di Dany, prima e dopo, casi cliente): segnaposto con "Da completare".
import Base from '../../layouts/Base.astro';
import QuizFooter from '../../components/QuizFooter.astro';
import { Image } from 'astro:assets';
import { casiPronti, titoloCaso, altCaso } from '../../data/quiz/casi.mjs';
import '../../styles/quiz.css';
import { LANDING } from '../../data/quiz/copy.mjs';

const L = LANDING;
// Casi cliente: schede salvate in src/assets/casi-quiz/. Senza file e consenso firmato restano i segnaposto.
// Foto di Dany: src/assets/dany-quiz/dany-hero, dany-prima, dany-dopo (vedi README in quella cartella).
const fotoDany = import.meta.glob('../../assets/dany-quiz/*.{png,jpg,jpeg,webp}', { eager: true });
const foto = (nome: string) =>
  (Object.entries(fotoDany).find(([p]) => (p.split('/').pop() ?? '').replace(/\.[a-z]+$/i, '').replace(/^noindex-/, '') === nome)?.[1] as { default: ImageMetadata } | undefined)?.default;
const fotoHero = foto('dany-hero');
const fotoTv = foto('dany-tv');
const fotoProfilo = foto('dany-profilo');
const fotoPalestra = foto('dany-palestra');
const fotoScheda = foto('dany-scheda');
const fotoAllievi = foto('dany-allievi');
const fotoPrima = foto('dany-prima');
const fotoDopo = foto('dany-dopo');
const messaggi = Object.entries(import.meta.glob('../../assets/messaggi-quiz/*.{png,jpg,jpeg,webp}', { eager: true })).map(([percorso, m]) => ({
  immagine: m.default,
  alt: L.messaggi.alt[percorso.split('/').pop().replace(/\.[^.]+$/, '').replace(/^noindex-/, '').replace(/^\d+-/, '')] ?? L.messaggi.altGenerico,
}));
const casi = casiPronti(import.meta.glob('../../assets/casi-quiz/*.{png,jpg,jpeg,webp}', { eager: true }));
// Icone di "Per chi è" e "Per chi non è": SVG, non emoji (le vieta la regola di copy del sito).
const SPUNTA = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12.5l5.5 5.5L20 6.5"/></svg>';
const CROCE = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>';
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Base
  title="Quiz petto scavato: scopri da dove iniziare | Percorso Alpha"
  description="Quiz sul petto scavato: 17 domande, 3 minuti. Il tuo profilo, una stima dei tempi realistici e il piano di allenamento a corpo libero adatto al tuo petto."
  path="/quiz/"
  noindex
  schema={false}
  bodyClass="qpage mode-paper"
>
  <header class="qbar">
    <div class="qwrap qwrap--wide qbar__in">
      <p class="qlock"><span>Percorso Alpha</span><i></i><em>Pectus</em></p>
    </div>
  </header>

  <main id="main" data-quiz data-turnstile={turnstile}>
    <p class="visually-hidden" role="status" aria-live="polite" data-live></p>

    <div data-landing>
      <section class="ql-hero">
        <div class="qwrap qwrap--wide ql-hero__grid">
          <div>
            <p class="ql-tag">
              {fotoProfilo && <Image src={fotoProfilo} alt={L.tag.alt} width={52} height={52} format="webp" quality={85} loading="eager" class="ql-tag__img" />}
              <span>{L.tag.text}</span>
            </p>
            <p class="ql-eyebrow">{L.eyebrow}</p>
            <h1 class="ql-h1" data-title>{L.titleA}</h1>
            <p class="ql-sub">{L.subtitle}</p>
            <div class="ql-cta">
              <button type="button" class="qz-btn" data-start>{L.cta}</button>
              <p class="ql-prova">{L.proofLine}</p>
            </div>
          </div>
          {
            fotoHero ? (
              <Image src={fotoHero} alt="Dany prima e dopo il percorso, a torso nudo." widths={[480, 720, 886]} sizes="(min-width: 900px) 540px, 92vw" format="webp" quality={84} loading="eager" class="ql-hero__img" />
            ) : (
              <div class="qph qph--photo" role="img" aria-label="Segnaposto per la foto di Dany">
                <span>Da completare: foto reale di Dany a torso nudo, luce naturale, nessun filtro, con autorizzazione d'uso.</span>
              </div>
            )
          }
        </div>
      </section>

      <section class="ql-sec ql-sec--tint">
        <div class="qwrap">
          <h2 class="ql-h2">{L.recognize.title}</h2>
          <ul class="ql-list">{L.recognize.items.map((t) => <li>{t}</li>)}</ul>
          <p class="ql-closing">{L.recognize.closing}</p>
        </div>
      </section>

      <section class="ql-sec">
        <div class="qwrap">
          <h2 class="ql-h2">{L.mechanism.title}</h2>
          {L.mechanism.paragraphs.map((t) => <p class="ql-p">{t}</p>)}
          <div class="ql-storia ql-palestra">
            <figure class="ql-foto">
              {
                fotoPalestra ? (
                  <Image src={fotoPalestra} alt={L.mechanism.gym.altPhoto} widths={[480, 720, 960]} sizes="(min-width: 900px) 360px, 46vw" format="webp" quality={82} loading="lazy" class="ql-foto__img" />
                ) : (
                  <div class="qph qph--ba"><span>Da completare: foto di Dany in palestra</span></div>
                )
              }
              <figcaption>{L.mechanism.gym.photo}</figcaption>
            </figure>
            <figure class="ql-foto">
              {
                fotoScheda ? (
                  <Image src={fotoScheda} alt={L.mechanism.gym.altCard} widths={[480, 720, 960]} sizes="(min-width: 900px) 360px, 46vw" format="webp" quality={84} loading="lazy" class="ql-foto__img" />
                ) : (
                  <div class="qph qph--ba"><span>Da completare: foto della scheda del personal trainer</span></div>
                )
              }
              <figcaption>{L.mechanism.gym.card}</figcaption>
            </figure>
          </div>
          <p class="ql-p ql-palestra__testo">{L.mechanism.gym.text}</p>
        </div>
      </section>

      <section class="ql-sec ql-sec--tint">
        <div class="qwrap">
          <div class="ql-chi">
            <div class="ql-chi__testo">
              <h2 class="ql-h2">{L.story.title}</h2>
              {L.story.paragraphs.map((t) => <p class="ql-p">{t}</p>)}
            </div>
            <figure class="ql-foto ql-chi__foto">
              {
                fotoAllievi ? (
                  <Image src={fotoAllievi} alt={L.story.altTeam} widths={[480, 720, 960]} sizes="(min-width: 900px) 420px, 92vw" format="webp" quality={82} loading="lazy" class="ql-foto__img ql-chi__img" />
                ) : (
                  <div class="qph qph--photo"><span>Da completare: foto di Dany con i suoi allievi</span></div>
                )
              }
              <figcaption>{L.story.team}</figcaption>
            </figure>
          </div>
          <div class="ql-storia">
            <figure class="ql-foto">
              {
                fotoPrima ? (
                  <Image src={fotoPrima} alt={L.story.altBefore} widths={[480, 720, 960]} sizes="(min-width: 900px) 360px, 46vw" format="webp" quality={82} loading="lazy" class="ql-foto__img" />
                ) : (
                  <div class="qph qph--ba"><span>Da completare: foto prima di Dany</span></div>
                )
              }
              <figcaption>{L.story.before}</figcaption>
            </figure>
            <figure class="ql-foto">
              {
                fotoDopo ? (
                  <Image src={fotoDopo} alt={L.story.altAfter} widths={[480, 720, 960]} sizes="(min-width: 900px) 360px, 46vw" format="webp" quality={82} loading="lazy" class="ql-foto__img" />
                ) : (
                  <div class="qph qph--ba"><span>Da completare: foto dopo di Dany</span></div>
                )
              }
              <figcaption>{L.story.after}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="ql-sec">
        <div class="qwrap qwrap--wide">
          <h2 class="ql-h2">{L.proof.title}</h2>
          {
            casi.length ? (
              <>
                <div class="ql-casi" data-casi>
                  {casi.map((c) => (
                    <figure class="ql-casi__fig">
                      <Image src={c.immagine} alt={altCaso(c)} widths={[480, 720, 960]} sizes="(min-width: 900px) 33vw, 92vw" format="webp" quality={84} loading="lazy" class="ql-casi__img" />
                      <figcaption class="ql-casi__cap">
                        <strong>{titoloCaso(c)}</strong>
                        <span><b>Punto di partenza:</b> {c.partenza}.</span>
                        <span><b>Risultato:</b> {c.risultato}.</span>
                        <span>{c.allenamenti}.</span>
                      </figcaption>
                    </figure>
                  ))}
                </div>
                <p class="ql-micro" style="margin-top:var(--space-4)">Casi individuali: i risultati variano da persona a persona.</p>
              </>
            ) : (
              <>
                <div class="ql-proof">
                  {Array.from({ length: L.proof.cases }).map(() => (
                    <div class="ql-case">
                      <div class="ql-case__pair">
                        <div class="qph qph--ba"><span>Da completare: prima</span></div>
                        <div class="qph qph--ba"><span>Da completare: dopo</span></div>
                      </div>
                      <p class="ql-micro">Da completare: mesi di percorso e una frase dell'interessato, solo con consenso scritto. Caso individuale.</p>
                    </div>
                  ))}
                </div>
                <p class="ql-micro" style="margin-top:var(--space-4)">{L.proof.placeholder}</p>
              </>
            )
          }
          {
            messaggi.length > 0 && (
              <div class="ql-msg" data-slider>
                <div class="ql-msg__head">
                  <h3 class="ql-h3">{L.messaggi.title}</h3>
                  <div class="ql-msg__nav">
                    <button type="button" class="ql-msg__btn" data-slider-prev aria-label="Messaggio precedente"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                    <button type="button" class="ql-msg__btn" data-slider-next aria-label="Messaggio successivo"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                  </div>
                </div>
                <div class="ql-msg__track" data-slider-track tabindex="0" role="region" aria-label={L.messaggi.title}>
                  {messaggi.map((m) => (
                    <figure class="ql-msg__slide">
                      <Image src={m.immagine} alt={m.alt} widths={[480, 720, 1060]} sizes="(min-width: 760px) 560px, 86vw" format="webp" quality={86} loading="lazy" class="ql-msg__img" />
                    </figure>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </section>

      <section class="ql-sec ql-sec--tint">
        <div class="qwrap qwrap--wide ql-tv">
          <div class="ql-tv__testo">
            <h2 class="ql-h2">{L.media.title}</h2>
            <p class="ql-p">{L.media.text}</p>
          </div>
          {
            fotoTv ? (
              <figure class="ql-foto ql-tv__fig">
                <Image src={fotoTv} alt={L.media.alt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 50vw, 92vw" format="webp" quality={82} loading="lazy" class="ql-tv__img" />
              </figure>
            ) : (
              <div class="qph ql-tv__ph"><span>{L.media.placeholder}</span></div>
            )
          }
        </div>
      </section>

      <section class="ql-sec">
        <div class="qwrap">
          <h2 class="ql-h2">{L.receive.title}</h2>
          <div class="ql-cards">{L.receive.cards.map((c, i) => <article class="ql-card"><span class="ql-card__n" aria-hidden="true">{i + 1}</span><h3>{c.title}</h3><p>{c.text}</p></article>)}</div>
        </div>
      </section>

      <section class="ql-sec ql-sec--tint">
        <div class="qwrap">
          <h2 class="ql-h2">{L.clarity.title}</h2>
          <p class="ql-p">{L.clarity.text}</p>
        </div>
      </section>

      <section class="ql-sec">
        <div class="qwrap qwrap--wide ql-two">
          <div class="ql-box">
            <h3>{L.forWho.title}</h3>
            <ul>{L.forWho.yes.map((t) => <li><span class="ql-ico ql-ico--si" aria-hidden="true" set:html={SPUNTA} /><span>{t}</span></li>)}</ul>
          </div>
          <div class="ql-box ql-box--no">
            <h3>{L.forWho.noTitle}</h3>
            <ul>{L.forWho.no.map((t) => <li><span class="ql-ico ql-ico--no" aria-hidden="true" set:html={CROCE} /><span>{t}</span></li>)}</ul>
          </div>
        </div>
      </section>

      <section class="ql-sec ql-sec--tint">
        <div class="qwrap">
          <h2 class="ql-h2">Domande frequenti</h2>
          <div class="ql-faq">
            {L.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
          <div class="ql-cta" style="margin-top:var(--space-6)">
            <button type="button" class="qz-btn" data-start>{L.cta}</button>
          </div>
        </div>
      </section>
    </div>

    <div class="ql-sticky" data-sticky inert>
      <button type="button" class="qz-btn" data-start>{L.cta}</button>
    </div>

    <section class="qz" data-stage hidden>
      <div class="qwrap" data-stage-in></div>
    </section>
  </main>

  <QuizFooter />
</Base>

<script>
  import '../../scripts/quiz.js';
  import '../../scripts/slider.js';
</script>
