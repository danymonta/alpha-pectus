---
// Informativa privacy /privacy/ (spec H, G.4, G.5, G.8). Piattaforma. Indicizzabile, in italiano.
// BOZZA IN ATTESA DI REVISIONE LEGALE (J.4 punto 6, J.5 punto 16). I dati aziendali vengono da AZIENDA
// (src/data/site.mjs). In sviluppo (astro dev) i dati mancanti escono come "da completare: ..." ben
// visibile, insieme all'avviso di revisione legale; in produzione la pagina usa frasi neutre al loro posto
// e non mostra l'avviso. Il controllo di lancio legge AZIENDA direttamente.
// Spazi: testo ed espressioni {…} restano sulla stessa riga, o con {' '} esplicito, altrimenti Astro
// toglie lo spazio tra il testo e il dato.
// Le parti su statistiche e pixel seguono la configurazione reale (ANALYTICS, PIXEL_ID).
// Nessun link DM qui (G.1). Testo da spostare in un file dati quando il legale lo approva.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Consenso from '../../components/Consenso.astro';
import Icon from '../../components/Icon.astro';
import { AZIENDA, ANALYTICS, PIXEL_ID, SOCIAL, SITE_UPDATED, HOSTING } from '../../data/site.mjs';
import { pagina404, footer } from '../../data/pagina';
import { dataIt } from '../../lib/testo';

const statistiche = Boolean(ANALYTICS.plausibleDomain);
const pixel = Boolean(PIXEL_ID);
const ig = SOCIAL.instagram.handle;
const DEV = import.meta.env.DEV;
const societaOk = Boolean(AZIENDA.ragioneSociale && AZIENDA.partitaIva);
const emailOk = Boolean(AZIENDA.email);
const host = HOSTING.nome;
const descrizione = statistiche
  ? 'Come pectus.percorsoalpha.com tratta i dati: statistiche senza cookie, nessun tracciamento pubblicitario senza consenso, la candidatura, i dati sulla salute e i tuoi diritti.'
  : 'Come pectus.percorsoalpha.com tratta i dati: nessun cookie di profilazione, nessun tracciamento pubblicitario senza consenso, la candidatura, i dati sulla salute e i tuoi diritti.';
---

<Base
  title="Informativa privacy | Percorso Alpha Pectus"
  description={descrizione}
  path="/privacy/"
  schema={false}
>
  <Header />
  <main id="main" class="privacy mode-night grain">
    <div class="wrap privacy__wrap">
      <article class="privacy__foglio sheet-paper" aria-labelledby="privacy-h1">
        <header class="privacy__testa">
          <p class="eyebrow">Percorso Alpha Pectus</p>
          <h1 id="privacy-h1" class="privacy__h1">Informativa privacy</h1>
          <p class="t-lead">
            Questa pagina spiega quali dati tratta pectus.percorsoalpha.com, perché, per quanto tempo e quali diritti
            hai. In breve: nessun cookie di profilazione, e i dati della candidatura (compresi quelli sulla salute)
            trattati solo con il tuo consenso esplicito e solo per valutare se il percorso fa per te.
          </p>
          {
            DEV && (
              <p class="privacy__avviso" role="note">
                Testo in attesa di revisione legale: può ancora cambiare. La data dell'ultimo aggiornamento è in fondo.
              </p>
            )
          }
        </header>

        <section class="privacy__blocco" aria-labelledby="titolare">
          <h2 id="titolare" class="privacy__h2">Chi tratta i tuoi dati</h2>
          <p>
            {
              societaOk ? (
                <>Il titolare del trattamento è Percorso Alpha, {AZIENDA.ragioneSociale}, P.IVA{' '}{AZIENDA.partitaIva}.</>
              ) : DEV ? (
                <>Il titolare del trattamento è Percorso Alpha,{' '}{AZIENDA.ragioneSociale || <span class="privacy__manca">da completare: ragione sociale e sede</span>}, P.IVA{' '}{AZIENDA.partitaIva || <span class="privacy__manca">da completare: partita IVA</span>}.</>
              ) : (
                <>Il titolare del trattamento è Percorso Alpha (dati societari in aggiornamento).</>
              )
            }{' '}{
              emailOk ? (
                <>Per qualsiasi domanda sui tuoi dati puoi scrivere a{' '}<a href={`mailto:${AZIENDA.email}`}>{AZIENDA.email}</a>.</>
              ) : DEV ? (
                <>Per qualsiasi domanda sui tuoi dati puoi scrivere a{' '}<span class="privacy__manca">da completare: email</span>.</>
              ) : (
                <>Per qualsiasi domanda sui tuoi dati puoi scrivermi su Instagram, a {ig}.</>
              )
            }
          </p>
        </section>

        <section class="privacy__blocco" aria-labelledby="visita">
          <h2 id="visita" class="privacy__h2">Quando visiti il sito</h2>
          {
            statistiche ? (
              <p>
                <strong>Statistiche senza cookie.</strong> Per capire quali parti della pagina sono utili usiamo
                Plausible Analytics, un servizio con server nell'Unione europea che non usa cookie, non conserva
                l'indirizzo IP e non segue le persone da un sito all'altro. Contiamo le visite, la provenienza (per
                esempio un link da Instagram o da YouTube), il tipo di dispositivo e alcune azioni sulla pagina, come
                aprire una domanda o toccare il bottone per scrivermi. Sono dati aggregati: non dicono chi sei.
              </p>
            ) : (
              <p>
                <strong>Statistiche.</strong> Oggi il sito non usa strumenti di statistica. Se li attiveremo, saranno
                senza cookie e con server nell'Unione europea, e questa informativa verrà aggiornata prima.
              </p>
            )
          }
          <p>
            <strong>Niente sul tuo corpo.</strong> Il sito non chiede e non registra informazioni sul tuo petto, sui
            sintomi o su testi che scrivi.
          </p>
          <p>
            <strong>Server.</strong> Il sito è ospitato da {host}, che per consegnare le pagine tratta dati tecnici
            come l'indirizzo IP e il tipo di browser nei registri del server, per il tempo necessario alla sicurezza
            del servizio. {host} agisce come responsabile del trattamento e può trattare questi dati anche fuori
            dall'Unione europea, con le garanzie previste dal GDPR.
          </p>
          <p>
            <strong>Nessuna richiesta a terzi.</strong> Caratteri, immagini e script arrivano dal nostro dominio:
            aprendo la pagina il tuo browser non contatta Google né altri servizi esterni.
          </p>
          <p>
            <strong>I bottoni della pagina.</strong> Portano al form di candidatura con un codice nel link (per esempio
            pe_offerta) che dice da quale punto della pagina e da quale canale arrivi. Non contiene dati personali.
          </p>
          {
            statistiche ? (
              <p class="privacy__base">
                Base giuridica: il legittimo interesse a far funzionare il sito e a misurarne l'uso in forma aggregata
                (art. 6, par. 1, lett. f del GDPR).
              </p>
            ) : (
              <p class="privacy__base">
                Base giuridica: il legittimo interesse a far funzionare il sito in sicurezza (art. 6, par. 1, lett. f
                del GDPR).
              </p>
            )
          }
        </section>

        <section class="privacy__blocco" aria-labelledby="pixel">
          <h2 id="pixel" class="privacy__h2">Pixel di Meta e consenso</h2>
          {
            pixel ? (
              <>
                <p>
                  Con il tuo consenso usiamo il pixel di Meta per misurare quali inserzioni portano visite e contatti.
                  Il pixel si carica solo dopo che tocchi Accetta nell'avviso in basso. Se rifiuti, o chiudi l'avviso,
                  non parte nessuna richiesta verso Meta e la pagina funziona uguale.
                </p>
                <p>
                  Il pixel invia a Meta Platforms Ireland solo la visita alla pagina e il tocco sul bottone per
                  scrivermi. La tua scelta resta salvata nel browser per 6 mesi come preferenza tecnica, e puoi
                  cambiarla quando vuoi con {footer.preferenzeCookie} in fondo alla pagina.
                </p>
                <p class="privacy__base">
                  Base giuridica: il tuo consenso (art. 6, par. 1, lett. a del GDPR), che puoi revocare in ogni momento.
                </p>
              </>
            ) : (
              <p>
                Oggi il sito non usa il pixel di Meta né altri strumenti pubblicitari, e non installa cookie di
                profilazione. Se un giorno li attiveremo, partiranno solo dopo il tuo consenso esplicito, chiesto con un
                avviso con i bottoni Accetta e Rifiuta, e questa informativa verrà aggiornata prima.
              </p>
            )
          }
        </section>

        <section class="privacy__blocco" aria-labelledby="candidatura">
          <h2 id="candidatura" class="privacy__h2">Quando invii la candidatura</h2>
          <p>
            Il form raccoglie nome, email, telefono, il tuo profilo Instagram se lo indichi, e le risposte sul tuo caso:
            età, cosa ti hanno detto i medici, eventuali sintomi, allenamento, abitudini, obiettivi e disponibilità.
          </p>
          <p>
            Le risposte le leggiamo io e il mio team, per capire se possiamo aiutarti e, se sì, per ricontattarti e
            fissare una chiamata. Non le usiamo per altro e non le cediamo a nessuno.
          </p>
          <p>
            Per gestirle usiamo due servizi che agiscono come responsabili del trattamento: Resend, che invia la mail di
            conferma a te e la notifica a noi, e Google, sul cui servizio Fogli è salvato l'elenco delle candidature.
            Entrambi possono trattare i dati anche fuori dall'Unione europea, con le garanzie previste dal GDPR
            (clausole contrattuali standard).
          </p>
          <p>
            <strong>Dati sulla salute.</strong> Le informazioni sul tuo petto e sui sintomi sono dati particolari (art. 9
            del GDPR). Le trattiamo solo se dai il consenso esplicito nel form, e solo per valutare la candidatura. Per
            candidarti non serve mandare foto.
          </p>
          <p class="privacy__base">
            Base giuridica: le misure precontrattuali che chiedi tu candidandoti (art. 6, par. 1, lett. b del GDPR) e,
            per i dati sulla salute, il tuo consenso esplicito (art. 9, par. 2, lett. a del GDPR), che puoi revocare in
            qualsiasi momento.
          </p>
        </section>

        <section class="privacy__blocco" aria-labelledby="durata">
          <h2 id="durata" class="privacy__h2">Per quanto tempo</h2>
          <ul class="privacy__lista">
            {statistiche && <li>Statistiche: solo in forma aggregata, senza dati che ti identificano.</li>}
            <li>
              Candidature: fino a 12 mesi dall'invio, poi le cancelliamo. Se inizi il percorso, per la sua durata e
              per gli obblighi di legge, per esempio quelli fiscali.
            </li>
            <li>Dati sulla salute: li cancelliamo quando non servono più, o prima se ce lo chiedi.</li>
            {pixel && <li>Scelta sul pixel di Meta: 6 mesi, nel tuo browser.</li>}
          </ul>
        </section>

        <section class="privacy__blocco" aria-labelledby="diritti">
          <h2 id="diritti" class="privacy__h2">I tuoi diritti</h2>
          <p>
            Puoi chiedere in ogni momento di accedere ai tuoi dati, di rettificarli o cancellarli, di limitarne il
            trattamento, di opporti, di riceverli in un formato leggibile e di revocare il consenso. La revoca non
            cambia la liceità di quanto fatto prima.
          </p>
          <p>
            {
              emailOk ? (
                <>Scrivi a{' '}<a href={`mailto:${AZIENDA.email}`}>{AZIENDA.email}</a>, oppure in DM su Instagram a {ig}.</>
              ) : DEV ? (
                <>Scrivi a{' '}<span class="privacy__manca">da completare: email</span>, oppure in DM su Instagram a {ig}.</>
              ) : (
                <>Scrivimi in DM su Instagram, a {ig}.</>
              )
            }{' '}Se pensi che i tuoi dati siano trattati in modo non corretto, puoi fare
            reclamo al Garante per la protezione dei dati personali (garanteprivacy.it).
          </p>
        </section>

        <footer class="privacy__piede">
          <p class="t-small t-muted">
            Ultimo aggiornamento: <time datetime={SITE_UPDATED}>{dataIt(SITE_UPDATED)}</time>. Se cambiano gli
            strumenti usati, aggiorniamo questa pagina e la data.
          </p>
          <a class="btn-outline privacy__torna" href={pagina404.href}>
            {pagina404.bottone}
            <Icon name="arrow-right" size={20} />
          </a>
        </footer>
      </article>
    </div>
  </main>
  <Footer compatto />
  <Consenso />
</Base>

<style>
  .privacy__wrap {
    position: relative;
    z-index: 2;
    padding-block: var(--space-6) var(--section-pad);
  }
  .privacy__foglio {
    max-width: 50rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--r-2);
    box-shadow: var(--shadow-sheet);
    background: var(--bg);
    color: var(--text);
  }
  .privacy__testa > * + * { margin-top: var(--space-4); }
  .privacy__h1 { font-size: var(--fs-h2); line-height: var(--lh-h2); }
  .privacy__avviso {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--steel);
    background: var(--surface);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text);
  }
  .privacy__blocco {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }
  .privacy__blocco > * + * { margin-top: var(--space-4); }
  .privacy__h2 {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-stretch: 100%;
    font-weight: 680;
    letter-spacing: -0.01em;
    line-height: var(--lh-h3);
  }
  .privacy__base { font-size: var(--fs-small); line-height: 1.5; color: var(--muted); }
  .privacy__lista { padding-left: 1.2em; }
  .privacy__lista li + li { margin-top: var(--space-2); }
  .privacy__lista li::marker { color: var(--accent-text); }
  .privacy__manca {
    padding: 0 .3em;
    border: 1px dashed var(--verdict);
    border-radius: var(--r-1);
    background: var(--amber-tint);
    color: var(--verdict);
    font-weight: 650;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .privacy__foglio a:not(.btn-outline) { color: var(--accent-text); }
  .privacy__piede {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .privacy__foglio { padding: var(--space-8) var(--space-8); }
  }
</style>
