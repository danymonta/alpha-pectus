# Variabili usate in build (Astro) e dalle Functions. Copia in .env.local (build) e .dev.vars (Functions in locale).
# Mai la chiave service_role in una variabile PUBLIC_.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TOKEN_SECRET=
# Facoltative
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
N8N_WEBHOOK_URL=
N8N_HMAC_SECRET=

# Avviso istantaneo su Telegram (facoltativo): bot creato con @BotFather e id della tua chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email di richiamo (dopo 1, 3 e 7 giorni): segreto condiviso con Vercel Cron e interruttore. Vedi docs/QUIZ.md
CRON_SECRET=
RICHIAMI_ATTIVI=
